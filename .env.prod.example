# Production / staging environment template — copy to `.env` before deploy.
# Never commit real secrets.

POSTGRES_DB=niha0
POSTGRES_USER=niha0
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-min-256-bits-secret-key-for-production-use-only!!
# JWT_PREVIOUS_SECRET=
SPRING_PROFILES_ACTIVE=prod
CORS_ORIGINS=https://app.your-domain.example
APP_PUBLIC_URL=https://app.your-domain.example

# Demo Flyway accounts blocked + deactivated (V14)
DEMO_LOGIN_ENABLED=false
# CSRF_ENABLED=false  # true when cookie-only mutations (ADR 008)

NGINX_PORT=80
BACKEND_PORT=8080

# Object storage — minio or s3 (local forbidden in prod)
STORAGE_MODE=minio
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY=change-me-minio-access
STORAGE_S3_SECRET_KEY=change-me-minio-secret
STORAGE_S3_BUCKET=niha0
STORAGE_S3_REGION=us-east-1
STORAGE_S3_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=300

# AI — real provider required in prod
AI_PROVIDER=openai
AI_OPENAI_API_KEY=sk-change-me
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_ALLOW_DEMO_FALLBACK=false

# Mail — SMTP required in prod
MAIL_MODE=smtp
MAIL_FROM=noreply@your-domain.example
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_change_me

# Billing SumUp (sandbox keys for staging)
BILLING_PROVIDER=sumup
SUMUP_API_KEY=sup_sk_change_me
SUMUP_MERCHANT_CODE=MCxxxxxxxxx
SUMUP_WEBHOOK_SECRET=change-me-webhook-secret
SUMUP_CURRENCY=EUR
SUMUP_REDIRECT_URL=https://app.your-domain.example/app/settings?billing=success
SUMUP_PRICE_PRO_CENTS=4900
SUMUP_PRICE_BUSINESS_CENTS=14900

# Realtime (optional Redis for multi-instance)
# REALTIME_MODE=redis
# NIHA0_REALTIME_REDIS_URL=redis://redis:6379
