# Production environment template — copy to `.env` and adjust before deploy.
POSTGRES_DB=niha0
POSTGRES_USER=niha0
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-min-256-bits-secret-key-for-production-use-only!!
SPRING_PROFILES_ACTIVE=prod
CORS_ORIGINS=https://your-domain.example
# Demo Flyway accounts (Demo2026!) blocked when false
DEMO_LOGIN_ENABLED=false
NGINX_PORT=80
BACKEND_PORT=8080

# Object storage — use minio or s3 in production (local forbidden)
STORAGE_MODE=minio
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY=change-me-minio-access
STORAGE_S3_SECRET_KEY=change-me-minio-secret
STORAGE_S3_BUCKET=niha0
STORAGE_S3_REGION=us-east-1
STORAGE_S3_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=300

# AI recommendation engine — mock | openai
AI_PROVIDER=mock
# AI_OPENAI_API_KEY=
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_MODEL=gpt-4o-mini
