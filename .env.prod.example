# Production / staging environment template — copy to `.env` before deploy.
# Never commit real secrets.
#
# Primary target: Cloudflare Pages + Render — see docs/ops/cloudflare-render.md

POSTGRES_DB=niha0
POSTGRES_USER=niha0
POSTGRES_PASSWORD=change-me-strong-password
# Render supplies DATABASE_URL (postgres://…) — also accepted at boot
# DATABASE_URL=postgres://niha0:…@dpg-….render.com/niha0
JWT_SECRET=change-me-min-256-bits-secret-key-for-production-use-only!!
# JWT_PREVIOUS_SECRET=
SPRING_PROFILES_ACTIVE=prod
CORS_ORIGINS=https://niha0.example
APP_PUBLIC_URL=https://niha0.example

# Demo Flyway accounts blocked + deactivated (V14)
DEMO_LOGIN_ENABLED=false
# CSRF_ENABLED=true  # prod default; Bearer still bypasses CSRF
# Cross-origin API (skip Pages /api proxy) :
# COOKIE_DOMAIN=.niha0.example
# COOKIE_SAME_SITE=None

NGINX_PORT=80
BACKEND_PORT=8080

# Object storage — Cloudflare R2 (recommended) or minio
STORAGE_MODE=s3
STORAGE_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_S3_ACCESS_KEY=change-me-r2-access
STORAGE_S3_SECRET_KEY=change-me-r2-secret
STORAGE_S3_BUCKET=niha0
STORAGE_S3_REGION=auto
STORAGE_S3_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=300

# AI — real provider required in prod
AI_PROVIDER=openai
AI_OPENAI_API_KEY=sk-change-me
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_ALLOW_DEMO_FALLBACK=false
RAG_EMBEDDING_PROVIDER=openai
RAG_PGVECTOR_ENABLED=true

# Sessions — access HttpOnly cookie + CSRF (prod defaults)
ACCESS_COOKIE_ENABLED=true
CSRF_ENABLED=true

# Mail — SMTP required in prod
MAIL_MODE=smtp
MAIL_FROM=noreply@niha0.example
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_change_me

# Billing SumUp (sandbox keys for staging)
BILLING_PROVIDER=sumup
SUMUP_API_KEY=sup_sk_change_me
SUMUP_MERCHANT_CODE=MCxxxxxxxxx
SUMUP_WEBHOOK_SECRET=change-me-webhook-secret
SUMUP_CURRENCY=EUR
SUMUP_REDIRECT_URL=https://niha0.example/app/settings?billing=success
SUMUP_PRICE_PRO_CENTS=4900
SUMUP_PRICE_BUSINESS_CENTS=14900

# Realtime (Render Redis from blueprint)
REALTIME_MODE=redis
# NIHA0_REALTIME_REDIS_URL=redis://…

# Cloudflare Pages Function (dashboard env, not Spring):
# API_ORIGIN=https://niha0-api.onrender.com
