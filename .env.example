# NIHAO — Networked Integrated Hub for Administration & Operations
# Copy to .env and adjust. Never commit real production secrets.

# --- Database ---
POSTGRES_DB=niha0
POSTGRES_USER=niha0
POSTGRES_PASSWORD=niha0
POSTGRES_PORT=5432

# --- Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=4200
NGINX_PORT=80

# --- Backend security ---
# Required in production (profile `prod`). Local profile supplies a weak default.
JWT_SECRET=niha0-dev-secret-change-in-production-min-256-bits-long-key!!
# JWT_PREVIOUS_SECRET=   # optional dual-secret rotation (verify-only)
CORS_ORIGINS=http://localhost:4200,http://localhost,http://localhost:80
DEMO_LOGIN_ENABLED=true
# CSRF_ENABLED=false     # true only when access JWT moves to cookies (ADR 008)

# --- OAuth2 / SSO (8 providers) ---
# OAUTH2_ENABLED=false          # true + CLIENT_ID/SECRET pairs → vrais IdP
# OAUTH2_DEMO_MODE=true         # défaut = DEMO_LOGIN_ENABLED — 8 providers simulés en local
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# AMAZON_CLIENT_ID=
# AMAZON_CLIENT_SECRET=

# --- RAG embeddings ---
# RAG_EMBEDDING_PROVIDER=hash
# RAG_EMBEDDING_PROVIDER=openai
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Spring ---
# local | docker | prod
SPRING_PROFILES_ACTIVE=local

# --- Object storage ---
# STORAGE_MODE=local|minio|s3
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_ACCESS_KEY=minioadmin
# STORAGE_S3_SECRET_KEY=minioadmin
# STORAGE_S3_BUCKET=niha0

# --- AI ---
# AI_PROVIDER=mock|openai
# AI_OPENAI_API_KEY=
# AI_OPENAI_ALLOW_DEMO_FALLBACK=false

# --- Billing SumUp ---
BILLING_PROVIDER=stub
# BILLING_PROVIDER=sumup
# SUMUP_API_KEY=
# SUMUP_MERCHANT_CODE=
# SUMUP_WEBHOOK_SECRET=
# SUMUP_API_BASE=https://api.sumup.com
# SUMUP_CURRENCY=EUR
# SUMUP_REDIRECT_URL=http://localhost:4200/app/settings?billing=success
# SUMUP_PRICE_PRO_CENTS=4900
# SUMUP_PRICE_BUSINESS_CENTS=14900

# --- Mail ---
MAIL_MODE=log
# MAIL_MODE=smtp
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=noreply@yourdomain.com
APP_PUBLIC_URL=http://localhost:4200

# --- Realtime ---
# REALTIME_MODE=memory|redis
# NIHA0_REALTIME_REDIS_URL=redis://localhost:6379
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
